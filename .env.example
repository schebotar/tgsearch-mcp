# Copy to .env (gitignored) and fill in your own app credentials:
#   https://my.telegram.org -> API development tools
#
# scripts/check_api.py reads this file automatically; `tgsearch-mcp` itself
# reads real environment variables, so export them first:
#   set -a && . ./.env && set +a
# or persist them with: python scripts/check_api.py --save

TG_API_ID=
TG_API_HASH=
